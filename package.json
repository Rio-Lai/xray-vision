{
  "name": "blowfish",
  "description": "Blowfish: voice-controlled X-ray vision for the physical world. Look at a thing, say \"explode this\", and a voice tutor explains its parts.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/lib/preflight.ts && concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "phone": "node scripts/phone.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pregenerate": "tsx scripts/pregenerate.ts",
    "fetch-models": "node scripts/fetch-models.mjs",
    "predemo": "node scripts/predemo.mjs",
    "check": "tsx scripts/check.ts",
    "agent:prompt": "tsx scripts/agent-prompt.ts",
    "agent:tools": "tsx scripts/agent-tools.ts",
    "build-eye": "tsx scripts/build-eye.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@elevenlabs/react": "latest",
    "@fal-ai/client": "latest",
    "@mediapipe/tasks-vision": "0.10.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "cloudflared": "^0.7.0",
    "concurrently": "^9.0.1",
    "meshoptimizer": "^0.22.0",
    "puppeteer-core": "^23.11.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
