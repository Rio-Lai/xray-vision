# Copy to .env and fill in. Never commit .env.
# Any key left empty puts that route in mock mode (answers from public/cache/).

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How hard Claude thinks: low (fastest) | medium | high | xhigh | max | none (older models that reject effort)
# Parts lists (default medium):
# ANTHROPIC_EFFORT=medium
# Naming an object from the camera (default low; it must answer within about 6 s):
# ANTHROPIC_IDENTIFY_EFFORT=low
# The overlay's whole-view scan (a small copy of the view, faces blacked out, every few seconds while the
# overlay is on; ?scan=0 in the app URL turns it off). Default: the main model at low effort.
# ANTHROPIC_SCAN_MODEL=claude-opus-5-5
# ANTHROPIC_SCAN_EFFORT=low

FAL_KEY=
# Optional overrides for the mesh pipeline
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_3D_MODEL=fal-ai/hunyuan3d/v2/turbo
# 1 = coloured meshes (default, about $0.42 a part), 0 = plain white (about $0.15)
FAL_TEXTURED=1

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# 1 = force mock mode for every route, even with keys set
MOCK=0

# API server port. Leave unset for the default (8791, set in server/lib/env.ts); the Vite proxy follows it.
# Do not use 8787: other dev tools use it.
# PORT=8791
